{
  "name": "smart-scheduling-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Smart Scheduling App for UCSC Students",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "node scripts/start-dev.mjs",
    "dev:all": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=client\" \"npm run dev:agent\"",
    "dev:mock": "node scripts/run-mock.mjs",
    "dev:agent": "node scripts/run-agent.js",
    "setup:agent": "node -e \"const { execSync } = require('child_process'); const cmd = process.platform === 'win32' ? 'py -3.11 -m venv agent_service/.venv && .\\\\agent_service\\\\.venv\\\\Scripts\\\\pip.exe install -r agent_service/requirements.txt' : 'python3.11 -m venv agent_service/.venv && agent_service/.venv/bin/pip install -r agent_service/requirements.txt'; execSync(cmd, { stdio: 'inherit' });\"",
    "db:reset": "rm -f data/app.db*",
    "build": "npm run build --workspace=shared && npm run build --workspace=server && npm run build --workspace=client",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test --workspaces --if-present -- --coverage",
    "test:coverage:agent": "node scripts/run-agent-tool.js pytest --cov=agent --cov=agent_api --cov-report=term-missing --cov-fail-under=70 tests",
    "test:agent": "node scripts/test-agent.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:codegen": "playwright codegen http://localhost:5173",
    "test:e2e:report": "playwright show-report",
    "typecheck": "npm run typecheck --workspaces",
    "typecheck:agent": "node scripts/run-agent-tool.js mypy agent agent_api",
    "typecheck:all": "npm run typecheck && npm run typecheck:agent",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:agent": "node scripts/run-agent-tool.js ruff check .",
    "lint:agent:fix": "node scripts/run-agent-tool.js ruff check --fix .",
    "lint:all": "npm run lint && npm run lint:agent",
    "format": "prettier --write \"{client,server,shared,e2e}/**/*.{ts,tsx,json}\" \"*.{ts,js,json}\"",
    "format:check": "prettier --check \"{client,server,shared,e2e}/**/*.{ts,tsx,json}\" \"*.{ts,js,json}\"",
    "format:agent": "node scripts/run-agent-tool.js ruff format .",
    "check:deadcode": "knip",
    "check:duplicates": "jscpd client server shared agent_service",
    "prepare": "husky",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up",
    "docker:down": "docker compose down",
    "clean": "rm -rf node_modules shared/node_modules server/node_modules client/node_modules shared/dist server/dist client/dist"
  },
  "lint-staged": {
    "*.{ts,tsx,json}": [
      "prettier --write",
      "eslint --fix"
    ],
    "agent_service/**/*.py": [
      "node scripts/run-agent-tool.js ruff format",
      "node scripts/run-agent-tool.js ruff check --fix"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "concurrently": "^8.2.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "jscpd": "^5.4.3",
    "knip": "^6.45.1",
    "lint-staged": "^15.4.3",
    "prettier": "^3.9.10"
  }
}
